# Environment Variables
# Copy this file to .env and fill in values

# Backend (auto-configured in Lovable Cloud)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# App Configuration
VITE_APP_NAME=IDEAL
VITE_APP_DOMAIN=https://your-domain.com

# Feature Flags
VITE_ENABLE_PASSKEYS=true
VITE_ENABLE_SMS_OTP=true

# SMS Provider (twilio, vonage, or custom)
VITE_SMS_PROVIDER=twilio
